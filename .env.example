# Chỉ là TÊN biến mẫu. Không bao giờ commit .env có giá trị thật.
# Trên Streamlit Cloud: đặt các biến này trong Manage app → Settings → Secrets (dạng TOML: KEY = "value").

# --- SSI FastConnect Data V3 (bắt buộc) ---
SSI_CLIENT_ID=
SSI_API_KEY=
SSI_API_SECRET=
# Khoảng cách tối thiểu giữa hai lần gọi REST (giây)
SSI_MIN_INTERVAL_SEC=1.0

# --- Giá realtime chỉ để hiển thị ---
# 1 = bản online tự mở SSI WebSocket khi có người xem (không chạy song song với worker cùng khóa)
AURA_LIVE_ENABLED=0
# Worker trên máy (scripts/ssi_live_worker.py): mã luôn theo dõi, số mã tối đa, chu kỳ lưu lịch sử/đẩy R2
AURA_LIVE_SYMBOLS=
AURA_LIVE_MAX=60
AURA_LIVE_ARCHIVE_SEC=60
AURA_LIVE_R2_PUSH_SEC=5

# --- Cloudflare R2 (bucket private: snapshot EOD, BCTC, giá realtime) ---
# Streamlit Cloud: khóa CHỈ ĐỌC. Máy cá nhân (upload/worker): khóa Object Read & Write.
AURA_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AURA_R2_BUCKET=
AURA_R2_ACCESS_KEY_ID=
AURA_R2_SECRET_ACCESS_KEY=
AURA_R2_PREFIX=aura-eod

# --- Khác ---
AURA_LOG_LEVEL=INFO
# 1 = cho phép nguồn giá dự phòng ngoài SSI (mặc định tắt; phải ghi rõ nguồn trong báo cáo)
BATDAY_CHO_PHEP_DU_PHONG_GIA=0
